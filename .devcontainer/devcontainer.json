{
  "name": "Safety map API and React",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install -r requirements.txt && npm --prefix field_web ci && if [ ! -f .env ]; then cp .env.example .env; fi",
  "postAttachCommand": {
    "api": ".venv/bin/uvicorn safety_dashboard.api.app:app --host 0.0.0.0 --port 8080 --env-file .env",
    "web": "npm --prefix field_web run dev"
  },
  "portsAttributes": {
    "5173": {
      "label": "Safety map",
      "onAutoForward": "openPreview"
    },
    "8080": {
      "label": "Safety map API",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [
    5173,
    8080
  ]
}
