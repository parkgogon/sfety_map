# Local API settings. Copy to .env and fill in locally; never commit real values.
KMA_API_KEY=
ADMIN_ACCESS_PASSWORD=
CCTV_ENABLED=false
ALERT_AUTOMATION_MODE=preview
# Disaster-message demo: server only; never use VITE_ for these secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_REASONING_EFFORT=low
# Optional place search. This is a Kakao REST key, not the JavaScript Maps key.
KAKAO_REST_API_KEY=
# On-demand official disaster-message feed (separate from the OpenAI/Kakao keys).
SAFETY_DATA_API_KEY=
# Local test storage only; Cloud Run rejects memory mode. Production uses firestore.
MESSAGE_REVIEW_STORE=memory
# Official automation stays off until the real API contract and access are verified.
MESSAGE_COLLECTION_ENABLED=false
MESSAGE_COLLECTION_CONTRACT_VERIFIED=false
MESSAGE_ANALYSIS_DAILY_LIMIT=20
MESSAGE_COLLECTION_MAX_PAGES=4
MESSAGE_COLLECTION_INTERVAL_MINUTES=15
MESSAGE_FEED_REQUEST_LIMIT=450
MESSAGE_COLLECTION_CATCHUP_DAYS=7
# Optional initial collection cutoff, aware ISO timestamp. First activation is persisted.
MESSAGE_COLLECTION_START_AT=
# Prepare previews and decisions; delivery additionally requires its flag and an explicit global start.
MESSAGE_NOTIFICATION_PREPARATION_ENABLED=false
# Opt-in latest page every 5 minutes / history hourly. Also set INTERVAL_MINUTES=5.
MESSAGE_COLLECTION_FAST_ENABLED=false
# Shared manual/automatic text AI budget, integer US cents. Off until rollout.
MESSAGE_AI_SPEND_BUDGET_ENABLED=false
MESSAGE_AI_DAILY_BUDGET_CENTS=100
MESSAGE_AI_MONTHLY_BUDGET_CENTS=2000
# Requires preview preparation. Narrow current evacuation original-text fallback.
MESSAGE_EMERGENCY_FALLBACK_ENABLED=false
# Deployment capability only. Each new deployment still requires a global start in the admin UI.
MESSAGE_DELIVERY_ENABLED=false
# Set GOOGLE_CLOUD_PROJECT/GCP_PROJECT_ID when using MESSAGE_REVIEW_STORE=firestore.
# Telegram/SMS credentials are deliberately absent. Local tests use fake providers.
