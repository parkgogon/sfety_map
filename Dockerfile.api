FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Seoul \
    PORT=8080

WORKDIR /app

COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

COPY core ./core
COPY safety_dashboard ./safety_dashboard
COPY data ./data
COPY facilities_info.csv ./facilities_info.csv

EXPOSE 8080

CMD ["sh", "-c", "uvicorn safety_dashboard.api.app:app --host 0.0.0.0 --port ${PORT}"]
